#!/bin/sh

branch=$(git rev-parse --abbrev-ref HEAD)
protected_pattern="^(main|dev|test)$"
branch_pattern="^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)/[a-z0-9]+(-[a-z0-9]+)*$"

if ! echo "$branch" | grep -Eq "$protected_pattern" && ! echo "$branch" | grep -Eq "$branch_pattern"; then
  echo "✖ branch name '$branch' doesn't match the required pattern '<type>/<kebab-case-description>'"
  echo "  allowed types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test"
  echo "  example: feat/user-profile-export"
  exit 1
fi

npx lint-staged
