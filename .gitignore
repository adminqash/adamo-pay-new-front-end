# ===================================
# Dependencies
# ===================================
# npm/yarn/pnpm package directories
node_modules/
.pnp
.pnp.js

# ===================================
# Build Outputs
# ===================================
# Vite production build output
dist/
# Vite SSR build output
dist-ssr/
# TypeScript incremental build cache
*.tsbuildinfo
tsconfig.tsbuildinfo

# ===================================
# Vite / Tooling Cache
# ===================================
.vite/
.eslintcache
.stylelintcache
.turbo/

# ============================================
# Environment Variables
# ============================================
# Environment files with credentials and secrets
.env
.env.*
.env.local
.env.*.local

# Allow example file (without real credentials)
!.env.example

# ===================================
# Logs
# ===================================
# Application and package manager logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===================================
# Testing & Coverage
# ===================================
# Test coverage reports
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
blob-report/

# ===================================
# IDE & Editor Files
# ===================================
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
# Cursor
.cursor/
# JetBrains IDEs (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.iws
# Visual Studio
*.suo
*.ntvs*
*.njsproj
*.sln
# Vim
*.sw?
*.swp
*.swo

# ===================================
# Operating System Files
# ===================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Git Bash / MSYS crash dumps (Windows)
*.stackdump
bash.exe.stackdump
# Linux
*~

# ===================================
# Temporary Files
# ===================================
# Various temporary files and caches
*.tmp
*.temp
.cache/
.parcel-cache/
*.local

# ===================================
# Optional local tooling
# ===================================
.vercel
.netlify
