VITE_API_BASE_URL=http://localhost:3600/api/v2

VITE_API_CORE_URL=http://localhost:3600/api/v2
VITE_API_BENEFICIARIES_URL=http://localhost:3601/api/v2
VITE_API_ANALYTICS_URL=http://localhost:3602/api/v2
VITE_API_REALTIME_URL=http://localhost:3603/api/v2

# Adamo Identity SSO (adamo-services-identity-microservice) — session cookies only, no static token.
VITE_ADAMO_API_BASE_URL=https://api-services-dev.adamoservices.co

# Adamo suite header (product switcher + brand link). Optional — falls back
# to "#" / an internal link when unset.
# VITE_ADAMO_LANDING_BASE_URL=https://dev.adamoservices.co
# VITE_ID_FRONT_BASE_URL=https://dev-id.adamoservices.co
# VITE_SIGN_FRONT_BASE_URL=https://dev-sign.adamoservices.co
# VITE_CHECK_FRONT_BASE_URL=https://dev-check.adamoservices.co

# Optional: Vite proxy targets (only if using /api/* via localhost:5173)
# VITE_DEV_PROXY_CORE_TARGET=http://localhost:3600
# VITE_DEV_PROXY_BENEFICIARIES_TARGET=http://localhost:3601
# VITE_DEV_PROXY_ANALYTICS_TARGET=http://localhost:3602
# VITE_DEV_PROXY_REALTIME_TARGET=http://localhost:3603

# Production — set explicit origins on each microservice:
# CORS_ORIGIN=https://your-frontend-domain.com
# VITE_API_CORE_URL=https://api.example.com/api/v2
# VITE_API_BENEFICIARIES_URL=https://beneficiaries.example.com/api/v2
# VITE_API_ANALYTICS_URL=https://analytics.example.com/api/v2
# VITE_API_REALTIME_URL=https://realtime.example.com/api/v2
