VITE_API_BASE_URL=http://localhost:5173/api/core

# Dev: use Vite proxy (same origin → no CORS). Restart `npm run dev` after changes.
VITE_API_CORE_URL=http://localhost:5173/api/core
VITE_API_BENEFICIARIES_URL=http://localhost:5173/api/beneficiaries
VITE_API_ANALYTICS_URL=http://localhost:5173/api/analytics
VITE_API_REALTIME_URL=http://localhost:5173/api/realtime
VITE_API_BEARER_TOKEN=your-provisional-bearer-token

# Optional: override proxy targets (backend ports)
# VITE_DEV_PROXY_CORE_TARGET=http://localhost:3600
# VITE_DEV_PROXY_BENEFICIARIES_TARGET=http://localhost:3601
# VITE_DEV_PROXY_ANALYTICS_TARGET=http://localhost:3602

# Production / direct API (no proxy) — set explicit origins on each microservice:
# CORS_ORIGIN=https://your-frontend-domain.com
# VITE_API_CORE_URL=https://api.example.com/api/v2
# VITE_API_BENEFICIARIES_URL=https://beneficiaries.example.com/api/v2
# VITE_API_ANALYTICS_URL=https://analytics.example.com/api/v2
